      "id": "file:src/features/flight/CockpitHUD.tsx",
      "type": "file",
      "name": "CockpitHUD.tsx",
      "filePath": "src/features/flight/CockpitHUD.tsx",
      "summary": "Renders the in-flight HUD overlay including a Canvas-based radar with enemy blips and waypoint markers, throttle bar, health/shield/energy stat bars, speed readout, and a target info panel; reads controls imperatively via a MutableRefObject to avoid React re-renders on keypress.",
      "tags": ["component", "ui", "hud", "game-ui", "event-handler"],
      "complexity": "complex",
      "languageNotes": "Uses imperative DOM mutations inside useFrame for the throttle bar fill, bypassing React state to eliminate per-keypress re-renders; the radar is drawn entirely on a canvas element via 2D context each frame."
    },
    {
      "id": "function:src/features/flight/CockpitHUD.tsx:CockpitHUD",
