      "id": "file:src/features/flight/PlayerShip.tsx",
      "type": "file",
      "name": "PlayerShip.tsx",
      "filePath": "src/features/flight/PlayerShip.tsx",
      "summary": "Core Three.js R3F scene object that loads the player ship GLTF model, drives flight physics each frame by reading controls imperatively, handles laser firing toward the lead pip, manages camera positioning for cockpit and 3rd-person modes, and checks waypoint proximity for mission objectives.",
      "tags": ["component", "game-logic", "flight-physics", "three-js", "entry-point"],
      "complexity": "complex",
      "languageNotes": "Caches controls.current as a local const at the top of each useFrame callback to avoid repeated MutableRef dereferences; combines Three.js useFrame physics with React state only for coarse perspective toggles."
    },
    {
      "id": "function:src/features/flight/PlayerShip.tsx:PlayerShip",
      "type": "function",
