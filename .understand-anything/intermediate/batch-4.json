      "name": "CockpitHUD",
      "filePath": "src/features/flight/CockpitHUD.tsx",
      "lineRange": [30, 341],
      "summary": "Main HUD React component that subscribes to combat, game, and mission stores and imperatively paints a radar canvas each frame via useFrame; exported as the primary consumer-facing component.",
      "tags": ["component", "hud", "game-ui", "event-handler"],
      "complexity": "complex"
    },
