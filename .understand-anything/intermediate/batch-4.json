      "type": "file",
      "name": "usePlayerControls.ts",
      "filePath": "src/hooks/usePlayerControls.ts",
      "summary": "Custom React hook that maps keyboard events to a stable MutableRefObject<Controls> using a user-configurable key-binding table, eliminating React re-renders on every keypress by writing directly into a ref instead of calling setState.",
      "tags": ["hook", "input", "performance", "game-logic"],
      "complexity": "moderate",
      "languageNotes": "The ref-based pattern is the key performance optimisation: consumers read controls.current inside useFrame without triggering React reconciliation on keydown/keyup events."
    },
